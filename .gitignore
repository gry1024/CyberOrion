# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Environment / secrets (NEVER commit)
.env
.env.local
*.key

# CAI framework tracing logs (auto-generated, large, not needed for repro)
logs/cai_*.jsonl

# Workspaces (agent-generated debug scripts, not part of the product)
workspaces/

# Session logs: only keep the 3 most recent under samples/
# (the logs/ dir itself is gitignored except for samples/)
logs/
!samples/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Temporary fix scripts
_fix_bug.py
_tmp_*.py
