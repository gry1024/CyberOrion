# ============================================================
# CyberOrion 环境配置模板
# ============================================================
# 用法：复制到 CAI 仓库根目录的 .env（不是 cyberorion/ 目录内）：
#   cp <cai-repo>/cyberorion/.env.example <cai-repo>/.env
# .env 已被 gitignore，绝不提交。
# server.py 与 run.py 启动时自动从仓库根加载 .env（不覆盖已有环境变量）。
# ============================================================

# ---------- LLM 配置（红蓝双 agent 与 LLM 裁判共用） ----------

# 模型名。经 OpenAI 兼容端点接入时建议带 openai/ 前缀。
CAI_MODEL=openai/deepseek-v4-flash

# API 密钥。
OPENAI_API_KEY=your-api-key-here

# OpenAI 兼容端点。代码里 OPENAI_API_BASE 优先于 OPENAI_BASE_URL，
# 两个都写上以兼容不同 SDK 读取路径。示例：
#   MiniMax:          https://api.minimaxi.chat/v1
#   DashScope (Qwen): https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI 官方:      两个都留空/删除即可
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ---------- 场景 ----------

# 激活的场景（scenarios/<名字>.yaml），默认 web_basic。
# 可选：web_basic（3 靶机）/ web_plus（+WebGoat+VAmPI，需
# docker compose --profile web_plus up -d）/ cve_log4j（单 CVE 专项）。
#CO_SCENARIO=web_basic

# ---------- 目标覆盖（可选，默认取场景 YAML 的值） ----------
# 仅当靶机 IP / 容器名 / 端口与场景默认值不同时才需要设置。

#CO_TARGET_DVWA_IP=172.29.0.10
#CO_TARGET_SSH_IP=172.29.0.12
#CO_TARGET_LOG4J_IP=172.29.0.20
#CO_DVWA_CONTAINER=cyberorion_dvwa
#CO_SSH_CONTAINER=cyberorion_weak_ssh
#CO_LOG4J_CONTAINER=cyberorion_log4j
#CO_DVWA_HOST_PORT=28080
#CO_LOG4J_HOST_PORT=8983
#CO_DVWA_HOST=127.0.0.1

# ---------- CAI 框架开关 ----------

# CAI 安全护栏：对抗场景下建议关闭（否则可能误拦红蓝工具的输出）。
# 注意：框架只认字面值 "false"，填 0 不会关闭。
CAI_GUARDRAILS=false

# CAI 自身的使用遥测（会上报框架使用数据）：建议关闭。
CAI_TELEMETRY=false

# ---------- Benchmark（bench/cybersoceval.py） ----------
# 推理型模型（如 deepseek-v4-flash）在长提示（rag 注入知识后）下会把
# max_tokens 全烧在思维链上、答案行为空 -> parse_fail 飙升。
# 设 disabled 时下发 {"thinking": {"type": "disabled"}} 关闭思维链
# （DeepSeek 兼容端点支持；其他端点不认识时保持注释即可）。
#CO_BENCH_THINKING=disabled

# ---------- 网络代理（可选） ----------
# 走代理的环境中，务必把靶场网段加入 no_proxy：
#NO_PROXY=localhost,127.0.0.1,172.29.0.0/24
#no_proxy=localhost,127.0.0.1,172.29.0.0/24

# ---------- LiteLLM 重试/超时（可选，防长连接断开） ----------
#LITELLM_NUM_RETRIES=1
#LITELLM_REQUEST_TIMEOUT=120

# ---------- 终端 ----------
#PROMPT_TOOLKIT_NO_CPR=1
