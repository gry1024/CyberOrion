# ============================================================
# CyberOrion Environment Configuration
# ============================================================
# Copy this file to .env (at the CAI repo root, NOT inside cyberorion/)
# and fill in your values. The .env file is gitignored and NEVER committed.
#
# Location: place .env at the SAME level as the cyberorion/ directory:
#   /home/<user>/cai/.env          <-- here
#   /home/<user>/cai/cyberorion/   <-- project
# ============================================================

# --- LLM Provider ---
# The model used by BOTH red and blue agents.
# Format: openai/<model-name>  (the "openai/" prefix is required by litellm
# to route through the OpenAI-compatible endpoint)
CAI_MODEL=openai/MiniMax-M3

# --- API Key ---
# Your LLM provider's API key.
OPENAI_API_KEY=your-api-key-here

# --- API Base URL ---
# The OpenAI-compatible endpoint. Examples:
#   MiniMax:  https://api.minimaxi.chat/v1
#   DashScope (Qwen): https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:   (leave unset to use the default OpenAI endpoint)
OPENAI_API_BASE=https://api.minimaxi.chat/v1

# Also set OPENAI_BASE_URL (some SDK versions read this instead)
OPENAI_BASE_URL=https://api.minimaxi.chat/v1

# --- CAI Framework Options ---
CAI_AGENT_TYPE=zero
CAI_GUARDRAILS=0
CAI_PARALLEL=0
CAI_STREAM=true
CAI_WORKSPACE=cyberorion
CAI_TRACING=false

# --- Network (optional, only if behind a proxy) ---
# NO_PROXY=localhost,127.0.0.1,172.29.0.0/24
# no_proxy=localhost,127.0.0.1,172.29.0.0/24

# --- LiteLLM retry/timeout (avoid long-command disconnects) ---
LITELLM_NUM_RETRIES=1
LITELLM_REQUEST_TIMEOUT=120

# --- Terminal ---
PROMPT_TOOLKIT_NO_CPR=1
